# Variáveis de ambiente — App da Família Figueiredo
#
# Copie este arquivo para `.env.local` e preencha os valores.
# O `.env.local` está no .gitignore — NUNCA commite segredos.
# Em produção, estas chaves vão no .env da VPS (runtime), nunca na imagem.

# ── Supabase ──────────────────────────────────────────────
# Públicas (podem ir pro client — prefixo NEXT_PUBLIC_):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Só server (NUNCA exponha no client):
SUPABASE_SECRET_KEY=
# URL do JWKS do projeto (validação de sessão):
SUPABASE_JWKS_URL=

# ── Azure Translator (tradução no leitor e na música) ─────
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# ── OpenAI (tradução no contexto / IA) ────────────────────
OPENAI_API_KEY=
